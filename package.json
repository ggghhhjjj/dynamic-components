{
  "name": "component-library",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",

    "clean": "rm -rf dist/ node_modules/.cache && echo '✅ Cleaned build artifacts'",
    "clean:all": "rm -rf dist/ node_modules && echo '✅ Cleaned all build artifacts and dependencies'",

    "build:ui-card": "ng build ui-card",
    "build:ui-table": "ng build ui-table",
    "build:ui-card-table": "ng build ui-card-table",
    "build:ui-header": "ng build ui-header",
    "build:libs": "npm run build:ui-card && npm run build:ui-table && npm run build:ui-card-table && npm run build:ui-header",

    "storybook": "ng run elements-host:storybook",
    "build:storybook": "ng run elements-host:build-storybook",
    "stop:storybook": "lsof -ti :6006 | xargs kill -9 2>/dev/null && echo '✅ Stopped Storybook' || echo '⚠️  Storybook not running'",

    "generate:elements": "node scripts/generate-elements-host.js",
    "build:wc": "npm run generate:elements && npm run build:libs && ng build elements-host --output-hashing none",

    "link:ui-card": "cd dist/ui-card && npm link",
    "link:all": "npm run build:libs && npm run link:ui-card"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/elements": "^21.2.16",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.14",
    "@angular/cli": "^21.0.1",
    "@angular/compiler-cli": "^21.0.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "storybook": "^10.4.2",
    "@storybook/angular": "^10.4.2",
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/addon-onboarding": "^10.4.2",
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular-devkit/architect": "^0.2100.0",
    "@angular-devkit/core": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@compodoc/compodoc": "^1.2.1"
  }
}
